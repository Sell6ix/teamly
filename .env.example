# --- App ---
AUTH_URL=http://127.0.0.1:4317
NEXT_PUBLIC_APP_URL=http://127.0.0.1:4317
# SQLite file (default: ./data/teamly.db)
DATABASE_URL=file:./data/teamly.db

# --- Auth.js (required for real sessions; demo login works with the fallback secret) ---
# openssl rand -base64 32
AUTH_SECRET=

# Discord OAuth app: https://discord.com/developers/applications → OAuth2
# Redirect: {AUTH_URL}/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# --- Discord bot (npm run bot) ---
# Bot token + invite with applications.commands + Send Messages
DISCORD_BOT_TOKEN=
# Channel where confirmed parties / /lfg posts go
DISCORD_LFG_CHANNEL_ID=
# Optional: faster slash-command deploy
DISCORD_GUILD_ID=
APP_URL=http://127.0.0.1:4317
